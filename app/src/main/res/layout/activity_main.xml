<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HFP status: initialising…"
        android:textSize="16sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEST: Trigger Siri now (AT+BVRA)" />

    <Button
        android:id="@+id/btnA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open Accessibility settings (enable KeyCatcher)" />

    <CheckBox
        android:id="@+id/chkDiscovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Discovery mode (toast every keycode seen)" />

    <EditText
        android:id="@+id/editKeycode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Trigger keycode (e.g. 231 = VOICE_ASSIST)"
        android:inputType="number" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save settings" />

</LinearLayout>
